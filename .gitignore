# ============================================================
#  绝对不能进 Git 的文件
#  ------------------------------------------------------------
#  Git 有个特性要留意：文件一旦被提交过，之后再加进 .gitignore
#  也删不掉历史里的那份 —— 密码仍然能从旧提交里翻出来。
#  所以这个文件必须在第一次 commit 之前就位。
#
#  已经误传过的话，唯一干净的办法是改掉那个密码，
#  而不是试图重写 Git 历史。
# ============================================================

# ── 配置文件：含数据库密码 ──
# 服务器上的正式配置由 config.example.php 复制而来，手动填密码，
# 永远不进版本库。这样我改代码不会覆盖你的线上密码，
# 你的密码也不会出现在 Gitee 上。
api/config.php
api/config.dev.php

# ── 开发专用，上线即风险 ──
# selftest.php 会输出 PHP 版本、扩展列表、数据库连接状态、
# 文件路径。这些对排查问题很有用，对扫站的人同样有用。
api/selftest.php

# ── 本地开发脚本，服务器上没意义 ──
dev-server.bat
dev-server.ps1

# ── 说明文档，不需要上线 ──
DEPLOY.md
DEV.md

# ── 系统与编辑器杂物 ──
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# ── 日志与备份 ──
*.log
*.bak
*.sql.gz
backup/
